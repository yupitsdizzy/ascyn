rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read their own data and write only under their userId path.
    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow creates/updates/deletes only when authenticated as the user.
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // More specific restrictions for xp_events to reduce tampering risk.
    match /users/{userId}/characters/{characterId}/xp_events/{eventId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // More strict create rules:
      // - must be owner
      // - event id must use one of the accepted prefixes to reduce tampering
      // - required fields present and typed
      // - new events must be created with status == 'active'
      // - clients cannot set reversal metadata on creation
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.characterId == characterId
        && (eventId.matches('^(task_|habit_|undo_).*$'))
        && request.resource.data.keys().hasAll(["uid","characterId","sourceType","sourceId","occurredAt","overallXp","statXp","status"])
        && request.resource.data.overallXp is number
        && request.resource.data.statXp is map
        && request.resource.data.status == 'active'
        && !request.resource.data.keys().hasAny(["reversedBy","undoNote","reversesEventId"]);

      // Allow update only when marking an event reversed via the defined fields
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(["status"]) 
        && request.resource.data.status == 'reversed'
        && request.resource.data.reversedBy is string;

      allow delete: if false;
    }

    // Protect character aggregates: only owner may update, and values must be numeric where present.
    match /users/{userId}/characters/{characterId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null
        && request.auth.uid == userId
        // overallXpTotal must be numeric if provided
        && ( !request.resource.data.keys().hasAny(["overallXpTotal"]) || request.resource.data.overallXpTotal is number )
        // statXpTotals must be a map of numbers if provided
        && ( !request.resource.data.keys().hasAny(["statXpTotals"]) || request.resource.data.statXpTotals is map )
        // lastEventAt must be a timestamp if provided
        && ( !request.resource.data.keys().hasAny(["lastEventAt"]) || request.resource.data.lastEventAt is timestamp )
        // lastEventId and lastEventNote must be strings if provided
        && ( !request.resource.data.keys().hasAny(["lastEventId"]) || request.resource.data.lastEventId is string )
        && ( !request.resource.data.keys().hasAny(["lastEventNote"]) || request.resource.data.lastEventNote is string );

      allow delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
